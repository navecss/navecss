# Dependencies
node_modules/

# Build output — never committed
packages/*/dist/

# Coverage reports — generated, no threshold gate, local/CI artifact only
packages/*/coverage/

# Turborepo
.turbo/

# Vitest browser mode — auto-captured failure screenshots/attachments, local debugging only
**/__screenshots__/
**/.vitest-attachments/

# Generated test fixtures — regenerated by
# packages/core/scripts/generate-consumer-theming-fixtures.ts before every test:browser run,
# same treatment as dist/.
packages/core/test/browser/fixtures/

# Scratch copy of atoms.ts the skill-guide drift test mutates on disk, inside the tracked test
# directory rather than os.tmpdir() (the mutated module needs workspace node_modules
# resolution). A finally block removes it on any normal exit; this line only guards against an
# abnormal test-process kill leaving it behind untracked.
packages/core/test/.atoms-mutation-*/

# Scratch apps and projects the Vite plugin's fixtures build under packages/core, so that `vue`, `sass`
# and `@navecss/tokens` resolve through its node_modules. Each test removes its own; this only guards
# against a killed test process leaving one behind untracked.
packages/core/.nave-*/

# OS
.DS_Store
Thumbs.db

# Husky internals
.husky/_/

# Agent worktrees — git worktrees the Claude Code harness creates for other branches.
# Only this subdirectory: .claude/settings.json is committed.
# Untracked, they also made the root `prettier --check .` (part of ci:check) walk every
# stray worktree's build and coverage output and fail on files from another branch.
.claude/worktrees/

# Editor — personal overrides only; .vscode/settings.json and extensions.json are committed
.vscode/*.local.json
.idea/
*.swp
