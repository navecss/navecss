{
  "extends": [
    "stylelint-config-standard",
    "@navecss/stylelint-config",
    "./stylelint.outline-guard.mjs"
  ],
  "plugins": [
    "stylelint-order",
    "stylelint-declaration-block-no-ignored-properties",
    "stylelint-declaration-strict-value",
    "stylelint-high-performance-animation"
  ],
  "ignoreFiles": ["**/dist/**", "**/node_modules/**"],
  "rules": {
    "color-no-invalid-hex": true,
    "unit-no-unknown": true,

    "property-no-unknown": [
      true,
      {
        "ignoreProperties": ["container-type", "container-name", "container"]
      }
    ],

    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["layer", "property", "container", "nave", "tailwind", "apply"]
      }
    ],

    "declaration-no-important": [
      true,
      {
        "message": "Avoid !important. Change the rule you are writing rather than this guard, and do not move a declaration into packages/core/src/reset.css to get around it: that file's two exceptions are exempted here for reasons stated beside them, and adding to them is not a way to pass this check. If you think the guard itself is wrong, open an issue."
      }
    ],

    "selector-class-pattern": [
      "^(nave-[a-z][a-z0-9]*(-[a-z0-9]+)*|[a-z][a-zA-Z0-9]*)$",
      {
        "message": "Class names must be either nave-kebab-case (global atoms) or camelCase (CSS Modules)."
      }
    ],

    "custom-property-pattern": [
      "^nave-[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      {
        "message": "Custom properties must begin with --nave-: every custom property Nave's own stylesheets declare or reference carries the namespace, so none can collide with a consumer's (R26)."
      }
    ],

    "order/properties-alphabetical-order": true,

    "plugin/declaration-block-no-ignored-properties": true,

    "plugin/no-low-performance-animation-properties": [
      true,
      {
        "ignore": "paint-properties"
      }
    ]
  },

  "overrides": [
    {
      "files": ["packages/core/src/reset.css"],
      "rules": {
        "scale-unlimited/declaration-strict-value": [
          [
            "/color/",
            "fill",
            "stroke",
            "background-color",
            "border-color",
            "outline-color",
            "font-size",
            "font-weight",
            "font-family",
            "border-radius",
            "transition-duration",
            "animation-duration",
            "box-shadow"
          ],
          {
            "disableFix": true,
            "expandShorthand": true,
            "ignoreKeywords": {
              "/color/": [
                "transparent",
                "currentColor",
                "currentcolor",
                "inherit",
                "none",
                "light",
                "dark",
                "light dark",
                "normal"
              ],
              "fill": ["currentColor", "currentcolor", "none", "transparent"],
              "stroke": ["currentColor", "currentcolor", "none", "transparent"],
              "background-color": ["transparent", "none"],
              "border-color": ["transparent", "currentColor", "inherit"],
              "outline-color": ["transparent", "currentColor"],
              "font-family": ["inherit"],
              "font-size": ["inherit", "1em"],
              "font-weight": ["inherit"],
              "border-radius": ["0"],
              "transition-duration": ["0ms", "0.01ms"],
              "animation-duration": ["0ms", "0.01ms"],
              "box-shadow": ["none"]
            }
          }
        ],
        "selector-class-pattern": null,
        "declaration-no-important": null,
        "property-no-vendor-prefix": [
          true,
          {
            "ignoreProperties": ["-webkit-text-size-adjust"]
          }
        ]
      }
    }
  ]
}
