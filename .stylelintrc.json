{
  "extends": ["stylelint-config-standard"],
  "plugins": [
    "stylelint-order",
    "stylelint-declaration-block-no-ignored-properties",
    "stylelint-declaration-strict-value",
    "stylelint-high-performance-animation"
  ],
  "ignoreFiles": ["**/dist/**", "**/node_modules/**"],
  "rules": {
    "color-no-invalid-hex": true,
    "unit-no-unknown": true,

    "declaration-property-value-disallowed-list": [
      {
        "outline": ["/^(none|0)$/i"]
      },
      {
        "message": "'outline: none'/'0' removes the focus indicator Nave's reset deliberately leaves to the user agent, with nothing shipped to replace it. Change the rule you are writing, not this guard. No selector carve-out is needed, and the ground is what this check can see rather than what the codebase contains: stylelint here reads only hand-authored CSS under src, so the focus-ring utility's own outline base, authored in TypeScript and reaching CSS only as generated output under dist, sits outside this guard by construction and is asserted from built output by packages/core/test/focus-ring-forced-colors.test.ts instead. Do not add an exemption for it, and do not widen this rule to reach it. If you think the guard itself is wrong, open an issue rather than changing it here. (A parallel text-decoration:none guard was probed here too and removed: probed red-first against a real violation, it caught nothing the built-output test packages/core/test/reset-link-decoration.test.ts did not, and that test alone stays.)"
      }
    ],
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": ["container-type", "container-name", "container"]
      }
    ],

    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["layer", "property", "container", "nave", "tailwind", "apply"]
      }
    ],

    "declaration-no-important": [
      true,
      {
        "message": "Avoid !important. Two deliberate exceptions ship, both in packages/core/src/reset.css and both explained in a comment beside the declarations they cover: `[hidden] { display: none !important }`, and the four declarations under `@media (prefers-reduced-motion: reduce)`. This rule is switched off for that whole file by the override below, not by inline disables, so a NEW !important added there passes this gate silently: read the comment above the block you are editing before you add one. Anywhere else, change the rule you are writing rather than this guard. If you think the guard itself is wrong, open an issue."
      }
    ],

    "selector-class-pattern": [
      "^(nave-[a-z][a-z0-9]*(-[a-z0-9]+)*|[a-z][a-zA-Z0-9]*)$",
      {
        "message": "Class names must be either nave-kebab-case (global atoms) or camelCase (CSS Modules)."
      }
    ],

    "custom-property-pattern": [
      "^([a-z][a-z0-9]*(-[a-z0-9]+)*)(--[a-z][a-z0-9]*(-[a-z0-9]+)*)?$",
      {
        "message": "Custom properties must follow --category-name-modifier pattern."
      }
    ],

    "order/properties-alphabetical-order": true,

    "plugin/declaration-block-no-ignored-properties": true,

    "plugin/no-low-performance-animation-properties": [
      true,
      {
        "ignore": "paint-properties"
      }
    ],

    "scale-unlimited/declaration-strict-value": [
      [
        "/color/",
        "fill",
        "stroke",
        "background-color",
        "border-color",
        "outline-color",
        "font-size",
        "font-weight",
        "font-family",
        "line-height",
        "letter-spacing",
        "border-radius",
        "transition-duration",
        "transition-timing-function",
        "animation-duration",
        "animation-timing-function",
        "gap",
        "padding",
        "padding-top",
        "padding-right",
        "padding-bottom",
        "padding-left",
        "margin",
        "margin-top",
        "margin-right",
        "margin-bottom",
        "margin-left",
        "z-index",
        "opacity",
        "box-shadow"
      ],
      {
        "disableFix": true,
        "expandShorthand": true,
        "ignoreKeywords": {
          "/color/": ["transparent", "currentColor", "inherit", "none"],
          "fill": ["currentColor", "none", "transparent"],
          "stroke": ["currentColor", "none", "transparent"],
          "background-color": ["transparent", "none"],
          "border-color": ["transparent", "currentColor"],
          "outline-color": ["transparent", "currentColor"],
          "font-family": ["inherit"],
          "font-size": ["inherit", "1em"],
          "font-weight": ["inherit"],
          "line-height": ["inherit", "normal"],
          "letter-spacing": ["inherit", "normal"],
          "border-radius": ["0"],
          "transition-duration": ["0ms", "0.01ms"],
          "animation-duration": ["0ms", "0.01ms"],
          "gap": ["0"],
          "padding": ["0"],
          "padding-top": ["0"],
          "padding-right": ["0"],
          "padding-bottom": ["0"],
          "padding-left": ["0"],
          "margin": ["0", "-1px", "auto"],
          "margin-top": ["0", "-1px", "auto"],
          "margin-right": ["0", "-1px", "auto"],
          "margin-bottom": ["0", "-1px", "auto"],
          "margin-left": ["0", "-1px", "auto"],
          "z-index": ["auto", "0"],
          "opacity": ["0", "1"],
          "box-shadow": ["none"]
        },
        "message": "Use a design token (var(--token-name)) instead of a raw value. Raw values bypass the token system and break design consistency."
      }
    ]
  },

  "overrides": [
    {
      "files": ["packages/core/src/reset.css"],
      "rules": {
        "scale-unlimited/declaration-strict-value": [
          [
            "/color/",
            "fill",
            "stroke",
            "background-color",
            "border-color",
            "outline-color",
            "font-size",
            "font-weight",
            "font-family",
            "border-radius",
            "transition-duration",
            "animation-duration",
            "box-shadow"
          ],
          {
            "disableFix": true,
            "expandShorthand": true,
            "ignoreKeywords": {
              "/color/": [
                "transparent",
                "currentColor",
                "currentcolor",
                "inherit",
                "none",
                "light",
                "dark",
                "light dark",
                "normal"
              ],
              "fill": ["currentColor", "currentcolor", "none", "transparent"],
              "stroke": ["currentColor", "currentcolor", "none", "transparent"],
              "background-color": ["transparent", "none"],
              "border-color": ["transparent", "currentColor", "inherit"],
              "outline-color": ["transparent", "currentColor"],
              "font-family": ["inherit"],
              "font-size": ["inherit", "1em"],
              "font-weight": ["inherit"],
              "border-radius": ["0"],
              "transition-duration": ["0ms", "0.01ms"],
              "animation-duration": ["0ms", "0.01ms"],
              "box-shadow": ["none"]
            }
          }
        ],
        "selector-class-pattern": null,
        "declaration-no-important": null,
        "property-no-vendor-prefix": [
          true,
          {
            "ignoreProperties": ["-webkit-text-size-adjust"]
          }
        ]
      }
    }
  ]
}
