{
  "name": "@navecss/core",
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "description": "Nave design system — layer architecture, reset, atomic utilities, and the Vite, PostCSS and Lightning CSS adapters and a command line for the @nave directive",
  "keywords": [
    "css",
    "design-system",
    "css-layers",
    "atomic-css",
    "postcss-plugin",
    "vite-plugin",
    "lightningcss",
    "zero-runtime"
  ],
  "homepage": "https://github.com/navecss/navecss/tree/main/packages/core#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/css.d.ts",
      "default": "./dist/index.css"
    },
    "./layers": {
      "types": "./dist/css.d.ts",
      "default": "./dist/layers.css"
    },
    "./no-tokens": {
      "types": "./dist/css.d.ts",
      "default": "./dist/no-tokens.css"
    },
    "./reset": {
      "types": "./dist/css.d.ts",
      "default": "./dist/reset.css"
    },
    "./atomic": {
      "types": "./dist/css.d.ts",
      "default": "./dist/atomic.css"
    },
    "./cx": {
      "types": "./dist/cx.d.ts",
      "import": "./dist/cx.js"
    },
    "./atoms": {
      "types": "./dist/atoms.d.ts",
      "import": "./dist/atoms.js"
    },
    "./postcss": {
      "import": {
        "types": "./dist/postcss.d.ts",
        "default": "./dist/postcss.js"
      },
      "require": {
        "types": "./dist/postcss.d.cts",
        "default": "./dist/postcss.cjs"
      }
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./lightningcss": {
      "types": "./dist/lightningcss.d.ts",
      "import": "./dist/lightningcss.js"
    },
    "./standalone": {
      "types": "./dist/css.d.ts",
      "default": "./dist/standalone.css"
    },
    "./check": {
      "types": "./dist/check.d.ts",
      "import": "./dist/check.js"
    },
    "./collect": {
      "types": "./dist/collect.d.ts",
      "import": "./dist/collect.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "navecss-core": "./dist/bin.js"
  },
  "files": [
    "dist",
    "CONSUMER-ATOMS.md",
    "ATOMS.md",
    "nave.css-data.json",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build-css.ts && tsup",
    "dev": "tsup --watch",
    "generate:migration-old-placement": "node scripts/generate-migration-old-placement.ts",
    "generate:property-table": "node scripts/generate-property-table.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/browser/tsconfig.json",
    "lint": "eslint src scripts \"test/**/*.ts\" --max-warnings 0 && stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:fix": "eslint src scripts \"test/**/*.ts\" --fix && stylelint \"src/**/*.css\" --fix",
    "test": "node scripts/generate-consumer-theming-fixtures.ts && node scripts/generate-vite-plugin-fixtures.ts && vitest run",
    "test:browser": "node scripts/generate-consumer-theming-fixtures.ts && node scripts/generate-vite-plugin-fixtures.ts && node scripts/generate-lightningcss-fixtures.ts && node scripts/generate-native-order-lightningcss-fixture.ts && node scripts/generate-no-bundler-fixture.ts && vitest run --config vitest.browser.config.ts && vitest run --config vitest.chromium.config.ts && pnpm run test:browser:engines",
    "test:browser:engines": "node scripts/generate-native-order-engine-fixtures.ts && vitest run --config vitest.browser.engines.config.ts",
    "check:pack": "node ../../scripts/without-dry-run.mjs publint && node ../../scripts/without-dry-run.mjs attw --pack . --profile esm-only",
    "prepublishOnly": "node ../../scripts/check-no-orphaned-chunks.mjs && pnpm run check:pack"
  },
  "peerDependencies": {
    "postcss": "^8"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@navecss/tokens": "workspace:^"
  },
  "devDependencies": {
    "@astrojs/node": "11.1.8",
    "@astrojs/react": "7.1.0",
    "@rmenke/css-tokenizer-tests": "1.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "astro": "7.4.0",
    "lightningcss": "1.33.0",
    "lightningcss-1-24": "npm:lightningcss@1.24.1",
    "mdn-data": "2.37.2",
    "playwright": "1.64.1",
    "postcss": "^8.5.28",
    "prettier": "3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "1.105.2",
    "source-map": "^0.8.0",
    "stylelint": "17.16.0",
    "stylelint-16-16": "npm:stylelint@16.16.0",
    "stylelint-16-17": "npm:stylelint@16.17.0",
    "svelte": "5.57.2",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-floor": "npm:vite@8.2.1",
    "vitest": "5.0.5",
    "vscode-css-languageservice": "6.3.10",
    "vue": "3.5.44"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navecss/navecss.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/navecss/navecss/issues"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
