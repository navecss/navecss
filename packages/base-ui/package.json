    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js",
      "default": "./dist/form/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js",
      "default": "./dist/checkbox/index.js"
    },
    "./checkbox-group": {
      "types": "./dist/checkbox-group/index.d.ts",
      "import": "./dist/checkbox-group/index.js",
      "default": "./dist/checkbox-group/index.js"
    },
    "./radio": {
      "types": "./dist/radio/index.d.ts",
      "import": "./dist/radio/index.js",
      "default": "./dist/radio/index.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group/index.d.ts",
      "import": "./dist/radio-group/index.js",
      "default": "./dist/radio-group/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js",
      "default": "./dist/switch/index.js"
    },
    "./slider": {
      "types": "./dist/slider/index.d.ts",
      "import": "./dist/slider/index.js",
      "default": "./dist/slider/index.js"
    },
    "./toggle": {
      "types": "./dist/toggle/index.d.ts",
      "import": "./dist/toggle/index.js",
      "default": "./dist/toggle/index.js"
    },
    "./toggle-group": {
      "types": "./dist/toggle-group/index.d.ts",
      "import": "./dist/toggle-group/index.js",
      "default": "./dist/toggle-group/index.js"
    },
    "./toolbar": {
      "types": "./dist/toolbar/index.d.ts",
      "import": "./dist/toolbar/index.js",
      "default": "./dist/toolbar/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-styles.ts && tsc -p tsconfig.build.json",
    "generate": "node scripts/generate-wrappers.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src styles scripts test --max-warnings 0",
    "lint:fix": "eslint src styles scripts test --fix",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "check:pack": "node ../../scripts/without-dry-run.mjs publint && node ../../scripts/without-dry-run.mjs attw --pack . --profile esm-only --exclude-entrypoints styles.css",
    "prepublishOnly": "node ../../scripts/check-no-orphaned-chunks.mjs && pnpm run check:pack"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@navecss/core": "workspace:*",
    "@navecss/tokens": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "base-ui-react-1.5.0": "npm:@base-ui/react@1.5.0",
    "base-ui-react-1.6.0": "npm:@base-ui/react@1.6.0",
    "base-ui-react-floor": "npm:@base-ui/react@1.3.0",
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.1",
    "playwright": "1.63.0",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "react": "^19.3.0",
    "react-18": "npm:react@^18.3.1",
    "react-dom": "^19.3.0",
    "react-dom-18": "npm:react-dom@^18.3.1",
    "rolldown": "1.2.12",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navecss/navecss.git",
    "directory": "packages/base-ui"
  },
  "bugs": {
    "url": "https://github.com/navecss/navecss/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@base-ui/react": "^1.3.0",
    "@navecss/tokens": ">=0.3.0 <1.0.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
