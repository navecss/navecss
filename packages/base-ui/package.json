{
  "name": "@navecss/base-ui",
  "version": "0.0.0",
  "private": true,
  "description": "NaveCSS styles Base UI's components with Nave's tokens: the same parts, the same props, pre-styled.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-styles.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint styles scripts test --max-warnings 0",
    "lint:fix": "eslint styles scripts test --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@navecss/core": "workspace:*",
    "@navecss/tokens": "workspace:*",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navecss/navecss.git",
    "directory": "packages/base-ui"
  },
  "bugs": {
    "url": "https://github.com/navecss/navecss/issues"
  }
}
