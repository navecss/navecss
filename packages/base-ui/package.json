{
  "name": "@navecss/base-ui",
  "version": "0.0.0",
  "description": "NaveCSS styles Base UI's components with Nave's tokens: the same parts, the same props, pre-styled.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js",
      "default": "./dist/dialog/index.js"
    },
    "./popover": {
      "types": "./dist/popover/index.d.ts",
      "import": "./dist/popover/index.js",
      "default": "./dist/popover/index.js"
    },
    "./menu": {
      "types": "./dist/menu/index.d.ts",
      "import": "./dist/menu/index.js",
      "default": "./dist/menu/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "import": "./dist/select/index.js",
      "default": "./dist/select/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "import": "./dist/tooltip/index.js",
      "default": "./dist/tooltip/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion/index.d.ts",
      "import": "./dist/accordion/index.js",
      "default": "./dist/accordion/index.js"
    },
    "./collapsible": {
      "types": "./dist/collapsible/index.d.ts",
      "import": "./dist/collapsible/index.js",
      "default": "./dist/collapsible/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "import": "./dist/tabs/index.js",
      "default": "./dist/tabs/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "default": "./dist/button/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js",
      "default": "./dist/input/index.js"
    },
    "./number-field": {
      "types": "./dist/number-field/index.d.ts",
      "import": "./dist/number-field/index.js",
      "default": "./dist/number-field/index.js"
    },
    "./field": {
      "types": "./dist/field/index.d.ts",
